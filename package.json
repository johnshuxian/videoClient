{
  "name": "videoclient",
  "version": "0.2.42",
  "private": true,
  "description": "Windows and macOS VOD desktop player",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:web && electron-builder",
    "build:web": "tsc -b && vite build",
    "build:web:harmony": "tsc -b && vite build --mode harmony",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:android": "npm run build:web && cap sync android && cd android && gradlew.bat assembleDebug",
    "dist:android-tv": "cd android-tv && gradlew.bat assembleRelease",
    "sync:harmony": "npm run build:web:harmony && node scripts/sync-harmony.mjs",
    "probe:tvbox": "node scripts/probe-tvbox-sources.mjs",
    "test": "node --test electron/*.test.cjs",
    "format": "prettier --write src electron vite.config.ts"
  },
  "dependencies": {
    "@sonn-audio/node-upnp": "^0.4.2",
    "artplayer": "^5.4.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "json5": "^2.2.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.shuxian.videoclient",
    "productName": "影窗",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "artifactName": "videoClient-v${version}-windows-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "artifactName": "videoClient-v${version}-macos-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "影窗需要访问局域网，以发现电视并向电视投送视频。"
      }
    }
  }
}
