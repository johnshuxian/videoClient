{
  "name": "videoclient",
  "version": "0.2.14",
  "private": true,
  "description": "Windows and macOS VOD desktop player",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:web && npm run build:airplay && electron-builder",
    "build:web": "tsc -b && vite build",
    "build:airplay": "node scripts/build-airplay.mjs",
    "dist:win": "npm run build:web && npm run build:airplay && electron-builder --win",
    "dist:mac": "npm run build:web && npm run build:airplay && electron-builder --mac",
    "test": "node --test electron/*.test.cjs",
    "format": "prettier --write src electron vite.config.ts"
  },
  "dependencies": {
    "@sonn-audio/node-upnp": "^0.4.2",
    "artplayer": "^5.4.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.shuxian.videoclient",
    "productName": "影窗",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "build/airplay/airplay-bridge.exe",
          "to": "airplay-bridge.exe"
        },
        {
          "from": "electron/airplay-license.md",
          "to": "airplay-license.md"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "build/airplay/airplay-bridge",
          "to": "airplay-bridge"
        },
        {
          "from": "electron/airplay-license.md",
          "to": "airplay-license.md"
        }
      ]
    }
  }
}
